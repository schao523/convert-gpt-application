{
  "schema_version": 2,
  "application_id": "plugin-builder",
  "plugin_id": "plugin-builder",
  "source_inventory": "docs/source-inventory.json",
  "source_location": "conversion.local.json",
  "coverage_matrix": "tests/coverage-matrix.md",
  "distribution_contract": "openclaw/distribution.json",
  "marketplace_repository": "schao523/obvious-one-plugins",
  "provenance": {
    "source_repository": "plugin-builder-approved-handoff-v1.0",
    "incorporated_branches": [],
    "inventory_rules": [
      {
        "root": ".",
        "classification": "approved-design-internal",
        "include": ["*"]
      }
    ]
  },
  "verification": {
    "test_directory": "tests",
    "commands": [
      {
        "id": "runtime-status",
        "argv": ["{python}", "-B", "{application_root}/scripts/plugin_builder.py", "status", "--json"],
        "marketplace_targets": ["codex"]
      },
      {
        "id": "session-validator",
        "argv": ["{python}", "-B", "{application_root}/scripts/plugin_builder.py", "validate-session", "{application_root}/tests/fixtures/session-valid.json", "--json"],
        "marketplace_targets": ["codex"]
      },
      {
        "id": "create-smoke",
        "argv": ["{python}", "-B", "-m", "unittest", "applications.plugin-builder.tests.test_end_to_end_scenarios.EndToEndScenarios.test_t2_create_with_bundled_local_tool_reaches_verified_deterministic_zip", "-v"],
        "marketplace_targets": ["codex"]
      },
      {
        "id": "update-smoke",
        "argv": ["{python}", "-B", "-m", "unittest", "applications.plugin-builder.tests.test_end_to_end_scenarios.EndToEndScenarios.test_t4_unexplained_update_content_and_tools_wait_and_survive", "-v"],
        "marketplace_targets": ["codex"]
      },
      {
        "id": "bundled-local-tool-smoke",
        "argv": ["{python}", "-B", "-m", "unittest", "applications.plugin-builder.tests.test_candidate_verification.CandidateVerificationTests.test_local_tool_executes_with_declared_fixture_and_direct_argv", "-v"],
        "marketplace_targets": ["codex"]
      }
    ],
    "codex_build": {
      "argv": ["{python}", "-B", "{application_root}/scripts/build_marketplace_release.py", "--source", "{application_root}", "--destination", "{diagnostics}/codex-marketplace", "--version", "{version}"],
      "artifact_path": "plugins/{plugin_id}"
    }
  }
}
