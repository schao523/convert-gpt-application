{
  "schema_version": 2,
  "application_id": "growing-with-children",
  "plugin_id": "growing-with-children",
  "source_inventory": "docs/source-inventory.json",
  "source_location": "conversion.local.json",
  "coverage_matrix": "tests/coverage-matrix.md",
  "distribution_contract": "openclaw/distribution.json",
  "marketplace_repository": "schao523/obvious-one-plugins",
  "provenance": {
    "source_repository": "externally-supplied-plugin-builder-archive",
    "incorporated_branches": [],
    "inventory_rules": [
      {
        "root": ".",
        "classification": "approved-repair-contract",
        "include": ["repair/delegated-reference-repair-v1.json"]
      }
    ]
  },
  "verification": {
    "test_directory": "tests",
    "commands": [
      {
        "id": "product-repair-tests",
        "argv": ["{python}", "-B", "-m", "unittest", "discover", "-s", "{application_root}/tests", "-v"],
        "marketplace_targets": ["codex"]
      }
    ],
    "codex_build": {
      "argv": ["{python}", "-B", "{application_root}/scripts/build_repaired_release.py", "--source", "{application_root}/source/growing-with-children-v1.0.1.zip", "--output", "{diagnostics}/growing-with-children-1.0.2", "--json"],
      "artifact_path": "growing-with-children-1.0.2.zip"
    }
  }
}
