{
  "schema_version": 2,
  "application_id": "plugin-alpha",
  "plugin_id": "plugin-alpha",
  "source_inventory": "../../docs/source.json",
  "source_location": "conversion.local.json",
  "coverage_matrix": "tests/coverage-matrix.md",
  "distribution_contract": "openclaw/distribution.json",
  "marketplace_repository": "example/plugins",
  "verification": {
    "test_directory": "tests",
    "commands": [{"id":"smoke","argv":["{python}","-B","{application_root}/scripts/product_check.py","smoke","--plugin-id","{plugin_id}"]}],
    "codex_build": {
      "argv": ["{python}","-B","{application_root}/scripts/product_check.py","build","--destination","{diagnostics}/codex-marketplace","--plugin-id","{plugin_id}"],
      "artifact_path": "plugins/{plugin_id}"
    },
    "marketplace": {
      "codex_path": "plugins/{plugin_id}",
      "openclaw_path": "openclaw/{plugin_id}",
      "approved_delta": "../../docs/delta.json"
    }
  }
}
