{
  "schema_version": 1,
  "plugin_id": "plugin-alpha",
  "package_name": "@obvious-one/plugin-alpha",
  "family": "bundle-plugin",
  "version": "1.0.0",
  "source_root": "source",
  "include_files": ["README.md", ".codex-plugin/plugin.json"],
  "include_prefixes": [],
  "exclude_paths": ["assets/index.bin", "assets/source.txt"],
  "max_total_bytes": 1048576,
  "release_repository": "example/obvious-one-plugins",
  "release_tag_template": "plugin-alpha-v{version}",
  "readme_overlay": null,
  "audit_hook": null,
