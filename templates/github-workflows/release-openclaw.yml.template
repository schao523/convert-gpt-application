name: Release {{PLUGIN_DISPLAY_NAME}} for OpenClaw

on:
  workflow_dispatch:
    inputs:
      publish:
        description: Publish immutable release assets and the OpenClaw bundle
        required: true
        default: false
        type: boolean

permissions:
  contents: read

env:
  PLUGIN_ID: "{{PLUGIN_ID}}"
  VERSION: "{{PLUGIN_VERSION}}"
  RELEASE_TAG: "{{RELEASE_TAG}}"

jobs:
  prepare:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Validate {{PLUGIN_ID}}
        run: python -B -m unittest discover -s plugins/{{PLUGIN_ID}}/tests -v
      - name: Upload prepared assets
        uses: actions/upload-artifact@v4
        with:
          name: ${{ env.PLUGIN_ID }}-${{ env.VERSION }}-release-assets
          path: release-assets/*
          if-no-files-found: error

  publish:
    if: ${{ inputs.publish }}
    needs: prepare
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
      - name: Refuse an existing immutable release
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          if gh release view "${RELEASE_TAG}" >/dev/null 2>&1; then
            exit 1
          fi
